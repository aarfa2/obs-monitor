{
  "name": "obs-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n hub,agent,web -c cyan,green,magenta \"npm run dev:hub\" \"npm run dev:agent\" \"npm run dev:web\"",
    "dev:hub": "tsx watch src/hub.ts",
    "dev:agent": "tsx watch src/agent.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "tsx watch src/hub.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx src/hub.ts",
    "start:agent": "tsx src/agent.ts",
    "user:add": "tsx src/user-cli.ts",
    "pack:agent": "node scripts/pack-agent.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.5.0",
    "obs-websocket-js": "^5.0.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
